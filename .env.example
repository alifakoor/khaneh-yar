# Public address of the site (no trailing slash). Used for the CSRF origin check.
APP_ORIGIN=https://khaneh-yar.darkube.ir

# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=change-this-to-at-least-32-random-characters

# SMS: "smsir" in production, "console" prints codes to the log (development only)
SMS_PROVIDER=smsir
# Header carrying the real client IP, set by the ingress (x-real-ip or x-forwarded-for)
CLIENT_IP_HEADER=x-real-ip
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=306964

MONGODB_DB=khanehyar
# Use URL-safe passwords (e.g. openssl rand -hex 24); they are embedded in the connection URI.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-this-root-password
MONGO_APP_USERNAME=khanehyar
MONGO_APP_PASSWORD=change-this-app-password

# Local development only (docker compose builds its own URI from the values above)
MONGODB_URI=mongodb://khanehyar:change-this-app-password@localhost:27017/?authSource=khanehyar
